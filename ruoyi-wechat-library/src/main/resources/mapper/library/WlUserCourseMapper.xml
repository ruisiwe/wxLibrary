<?xml version="1.0" encoding="UTF-8" ?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.ruoyi.library.mapper.WlUserCourseMapper"><resultMap id="r" type="com.ruoyi.library.domain.WlUserCourse"><id property="id" column="id"/><result property="userId" column="user_id"/><result property="courseId" column="course_id"/><result property="courseCodeId" column="course_code_id"/><result property="accessSource" column="access_source"/><result property="permanent" column="is_permanent"/><result property="grantedTime" column="granted_time"/></resultMap><select id="selectByUserCourse" resultMap="r">select id,user_id,course_id,course_code_id,access_source,is_permanent,granted_time from wl_user_course where user_id=#{userId} and course_id=#{courseId} and del_flag='0'</select><insert id="insertGrant" parameterType="com.ruoyi.library.domain.WlUserCourse" useGeneratedKeys="true" keyProperty="id">insert into wl_user_course(user_id,course_id,course_code_id,access_source,is_permanent,granted_time,create_by,create_time,update_by,update_time,del_flag) values(#{userId},#{courseId},#{courseCodeId},#{accessSource},#{permanent},#{grantedTime},#{createBy},now(),'',now(),'0')</insert></mapper>
