<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.library.mapper.WlVipOrderMapper">
 <resultMap id="r" type="com.ruoyi.library.domain.WlVipOrder"><id property="id" column="id"/><result property="userId" column="user_id"/><result property="planId" column="plan_id"/><result property="merchantOrderNo" column="merchant_order_no"/><result property="wechatTransactionId" column="wechat_transaction_id"/><result property="planCodeSnapshot" column="plan_code_snapshot"/><result property="planNameSnapshot" column="plan_name_snapshot"/><result property="amountCent" column="amount_cent"/><result property="currency" column="currency"/><result property="validDaysSnapshot" column="valid_days_snapshot"/><result property="giftPointsSnapshot" column="gift_points_snapshot"/><result property="orderStatus" column="order_status"/><result property="paidTime" column="paid_time"/><result property="closedTime" column="closed_time"/></resultMap>
 <sql id="c">select id,user_id,plan_id,merchant_order_no,wechat_transaction_id,plan_code_snapshot,plan_name_snapshot,amount_cent,currency,valid_days_snapshot,gift_points_snapshot,order_status,paid_time,closed_time from wl_vip_order</sql>
 <select id="selectById" resultMap="r"><include refid="c"/> where id=#{id} and del_flag='0'</select>
 <select id="selectByIdForUpdate" resultMap="r"><include refid="c"/> where id=#{id} and del_flag='0' for update</select>
 <select id="selectByMerchantOrderNoForUpdate" resultMap="r"><include refid="c"/> where merchant_order_no=#{merchantOrderNo} and del_flag='0' for update</select>
 <select id="selectList" parameterType="com.ruoyi.library.domain.WlVipOrder" resultMap="r"><include refid="c"/><where>del_flag='0'<if test="userId != null"> and user_id=#{userId}</if><if test="orderStatus != null and orderStatus != ''"> and order_status=#{orderStatus}</if></where> order by id desc</select>
 <insert id="insertOrder" parameterType="com.ruoyi.library.domain.WlVipOrder" useGeneratedKeys="true" keyProperty="id">insert into wl_vip_order(user_id,plan_id,merchant_order_no,plan_code_snapshot,plan_name_snapshot,amount_cent,currency,valid_days_snapshot,gift_points_snapshot,order_status,create_by,create_time,update_by,update_time,del_flag) values(#{userId},#{planId},#{merchantOrderNo},#{planCodeSnapshot},#{planNameSnapshot},#{amountCent},#{currency},#{validDaysSnapshot},#{giftPointsSnapshot},#{orderStatus},#{createBy},now(),'',now(),'0')</insert>
 <update id="markPrepayReady">update wl_vip_order set order_status='PREPAY_READY',update_time=now() where id=#{id} and order_status='CREATED' and del_flag='0'</update>
 <update id="markPaid">update wl_vip_order set order_status='PAID',wechat_transaction_id=#{transactionId},paid_time=#{paidTime},update_time=now() where id=#{id} and order_status in ('CREATED','PREPAY_READY') and del_flag='0'</update>
 <update id="markRefundProcessing">update wl_vip_order set order_status='REFUND_PROCESSING',update_time=now() where id=#{id} and order_status='PAID' and del_flag='0'</update>
 <update id="markRefunded">update wl_vip_order set order_status='REFUNDED',update_time=now() where id=#{id} and order_status='REFUND_PROCESSING' and del_flag='0'</update>
</mapper>
