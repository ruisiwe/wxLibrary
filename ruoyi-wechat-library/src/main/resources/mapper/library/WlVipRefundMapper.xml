<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.library.mapper.WlVipRefundMapper">
 <resultMap id="r" type="com.ruoyi.library.domain.WlVipRefund"><id property="id" column="id"/><result property="orderId" column="order_id"/><result property="userId" column="user_id"/><result property="merchantRefundNo" column="merchant_refund_no"/><result property="wechatRefundId" column="wechat_refund_id"/><result property="refundAmountCent" column="refund_amount_cent"/><result property="refundStatus" column="refund_status"/><result property="shouldReclaimPoints" column="should_reclaim_points"/><result property="reclaimedPoints" column="reclaimed_points"/><result property="unrecoveredPoints" column="unrecovered_points"/><result property="entitlementRevoked" column="entitlement_revoked"/><result property="successTime" column="success_time"/><result property="failureReason" column="failure_reason"/><result property="operatorId" column="operator_id"/><result property="reason" column="reason"/><result property="acceptedTime" column="accepted_time"/></resultMap>
 <sql id="c">select id,order_id,user_id,merchant_refund_no,wechat_refund_id,refund_amount_cent,refund_status,should_reclaim_points,reclaimed_points,unrecovered_points,entitlement_revoked,success_time,failure_reason,operator_id,reason,accepted_time from wl_vip_refund</sql>
 <select id="selectByOrderId" resultMap="r"><include refid="c"/> where order_id=#{orderId} and del_flag='0'</select>
 <select id="selectByMerchantRefundNoForUpdate" resultMap="r"><include refid="c"/> where merchant_refund_no=#{merchantRefundNo} and del_flag='0' for update</select>
 <select id="selectList" parameterType="com.ruoyi.library.domain.WlVipRefund" resultMap="r"><include refid="c"/><where>del_flag='0'<if test="userId != null"> and user_id=#{userId}</if><if test="refundStatus != null and refundStatus != ''"> and refund_status=#{refundStatus}</if></where> order by id desc</select>
 <insert id="insertRefund" parameterType="com.ruoyi.library.domain.WlVipRefund" useGeneratedKeys="true" keyProperty="id">insert into wl_vip_refund(order_id,user_id,merchant_refund_no,refund_amount_cent,refund_status,should_reclaim_points,reclaimed_points,unrecovered_points,entitlement_revoked,operator_id,reason,create_by,create_time,update_by,update_time,del_flag) values(#{orderId},#{userId},#{merchantRefundNo},#{refundAmountCent},#{refundStatus},#{shouldReclaimPoints},0,0,'0',#{operatorId},#{reason},#{createBy},now(),'',now(),'0')</insert>
 <update id="markAccepted">update wl_vip_refund set refund_status='ACCEPTED',wechat_refund_id=coalesce(#{wechatRefundId},wechat_refund_id),accepted_time=now(),update_time=now() where id=#{id} and refund_status in ('CREATED','PROCESSING','ACCEPTED') and del_flag='0'</update>
 <update id="markSuccess">update wl_vip_refund set refund_status='SUCCESS',wechat_refund_id=#{wechatRefundId},success_time=#{successTime},reclaimed_points=#{reclaimedPoints},unrecovered_points=#{unrecoveredPoints},entitlement_revoked=#{entitlementRevoked},update_time=now() where id=#{id} and refund_status in ('PROCESSING','ACCEPTED') and del_flag='0'</update>
 <update id="markFailed">update wl_vip_refund set refund_status='FAILED',failure_reason=#{reason},update_time=now() where id=#{id} and refund_status in ('CREATED','PROCESSING','ACCEPTED') and del_flag='0'</update>
</mapper>
