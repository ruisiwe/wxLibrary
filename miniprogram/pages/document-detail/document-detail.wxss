.page{min-height:100vh;padding:30rpx 30rpx 80rpx}.cover{width:100%;height:380rpx;border-radius:24rpx;background:#e2e8f0}.card{margin-top:24rpx;padding:30rpx;background:#fff;border-radius:24rpx}.title{font-size:40rpx;font-weight:600}.meta,.summary{margin-top:20rpx;color:#64748b;line-height:1.7}.price{margin-top:24rpx;color:#f59e0b;font-weight:600}.actions{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin-top:28rpx}.actions button{width:100%;font-size:27rpx}.actions .primary{background:#2457d6;color:#fff}
