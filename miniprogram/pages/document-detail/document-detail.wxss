.page{min-height:100vh;padding:30rpx 30rpx 80rpx}.cover{width:100%;height:380rpx;border-radius:24rpx;background:#e2e8f0}.card{margin-top:24rpx;padding:30rpx;background:#fff;border-radius:24rpx}.title{font-size:40rpx;font-weight:600}.meta,.summary{margin-top:20rpx;color:#64748b;line-height:1.7}.price{display:flex;gap:16rpx;align-items:center;margin-top:24rpx;color:#f59e0b;font-weight:600}.vip-free{padding:6rpx 14rpx;border-radius:999rpx;background:#eef2ff;color:#2457d6;font-size:24rpx}.actions{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin-top:28rpx}.actions button{width:100%;font-size:27rpx}.actions .primary,.disclaimer-actions .primary{background:#2457d6;color:#fff}.disclaimer-mask{position:fixed;z-index:1000;inset:0;display:flex;align-items:center;justify-content:center;padding:40rpx;background:rgba(15,23,42,.58)}.disclaimer-dialog{width:100%;padding:32rpx;background:#fff;border-radius:26rpx}.disclaimer-title{font-size:34rpx;font-weight:600;text-align:center}.disclaimer-content{height:520rpx;margin:24rpx 0;padding:22rpx;box-sizing:border-box;background:#f8fafc;border-radius:16rpx;line-height:1.8;white-space:pre-wrap}.disclaimer-checkbox{display:flex;align-items:center;color:#475569}.disclaimer-actions{display:grid;grid-template-columns:1fr 1.5fr;gap:18rpx;margin-top:26rpx}.disclaimer-actions button{font-size:26rpx}
