<view class="page">
  <state-view loading="{{loading}}" error="{{error}}" bindretry="load"/>
  <view wx:if="{{document}}">
    <image class="cover" src="{{document.coverUrl}}" mode="aspectFill"/>
    <view class="card">
      <view class="title">{{document.title}}</view>
      <view class="meta">{{document.categoryName}} · {{document.pageCount || 0}} 页 · {{document.fileFormat}}</view>
      <view class="summary">{{document.summary || '暂无简介'}}</view>
      <view class="price">
        <text wx:if="{{vipFreeDocument}}" class="vip-free">会员免费</text>
        <text>{{document.pointPrice || 0}} 积分永久兑换</text>
      </view>
    </view>
    <view class="actions">
      <button bindtap="preview">试读</button>
      <button wx:if="{{!unlocked}}" class="primary" bindtap="unlock">{{vipFreeDocument && vipActive ? '免费下载' : '积分兑换'}}</button>
      <button bindtap="toggleFavorite">{{favorite ? '取消收藏' : '收藏'}}</button>
      <button wx:if="{{unlocked}}" loading="{{sendingOriginal}}" bindtap="shareOriginal">发送原文件</button>
    </view>
  </view>
  <view wx:if="{{disclaimerVisible}}" class="disclaimer-mask">
    <view class="disclaimer-dialog">
      <view class="disclaimer-title">{{fileDisclaimer.title}}</view>
      <scroll-view scroll-y class="disclaimer-content"><text user-select>{{fileDisclaimer.content}}</text></scroll-view>
      <checkbox-group bindchange="onSuppressReminderChange">
        <label class="disclaimer-checkbox"><checkbox value="suppress" checked="{{suppressReminder}}"/>以后不再提示</label>
      </checkbox-group>
      <view class="disclaimer-actions">
        <button bindtap="cancelDisclaimer">取消</button>
        <button class="primary" bindtap="confirmDisclaimer">已阅读，继续发送</button>
      </view>
    </view>
  </view>
  <login-sheet visible="{{loginVisible}}" agreements="{{agreements}}" profile-required="{{profileRequired}}" bindclose="closeLogin" bindsubmit="submitLogin"/>
</view>
