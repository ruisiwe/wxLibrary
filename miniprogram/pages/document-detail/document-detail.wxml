<view class="page"><state-view loading="{{loading}}" error="{{error}}" bindretry="load"/><view wx:if="{{document}}"><image class="cover" src="{{document.coverUrl}}" mode="aspectFill"/><view class="card"><view class="title">{{document.title}}</view><view class="meta">{{document.categoryName}} · {{document.pageCount || 0}} 页 · {{document.fileFormat}}</view><view class="summary">{{document.summary || '暂无简介'}}</view><view class="price">{{document.pointPrice || 0}} 积分永久兑换</view></view><view class="actions"><button bindtap="preview">试读</button><button class="primary" bindtap="unlock">积分兑换</button><button bindtap="toggleFavorite">{{favorite ? '取消收藏' : '收藏'}}</button><button bindtap="openFull">打开完整 PDF</button><button bindtap="shareOriginal">分享原文件</button></view></view><login-sheet visible="{{loginVisible}}" agreements="{{agreements}}" bindclose="closeLogin" bindsubmit="submitLogin"/></view>
