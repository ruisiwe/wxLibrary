.page{min-height:100vh;padding:30rpx}.current{padding:42rpx;background:linear-gradient(135deg,#0b1f3a,#334155);color:#fef3c7;border-radius:28rpx}.expiry{margin-top:16rpx;font-size:34rpx;font-weight:600}.payment{margin-top:20rpx;padding:20rpx;text-align:center;background:#eff6ff;color:#1d4ed8;border-radius:16rpx}.plan{display:flex;justify-content:space-between;margin-top:24rpx;padding:30rpx;background:#fff;border-radius:22rpx}.plan__name{font-size:32rpx;font-weight:600}.plan__meta{margin-top:14rpx;color:#64748b;font-size:24rpx}.plan__right{text-align:right;color:#f59e0b;font-weight:600}.plan__right button{margin-top:14rpx;background:#2457d6;color:#fff}.benefits,.customer-service{margin-top:24rpx;padding:30rpx;background:#fff;border-radius:22rpx}.section-title{margin-bottom:20rpx;font-size:32rpx;font-weight:700;color:#0f172a}.benefit{display:flex;align-items:flex-start;padding:14rpx 0;color:#334155;font-size:28rpx;line-height:40rpx}.benefit__mark{flex:none;width:44rpx;color:#d69e2e;font-weight:700}.config-state{margin-top:24rpx;padding:24rpx;border-radius:18rpx;background:#fff;color:#64748b;text-align:center;font-size:26rpx}.config-state--error{background:#fff7ed;color:#c2410c}.config-retry{margin-left:20rpx;color:#2457d6;font-weight:600}.customer-service{text-align:center}.customer-service__image{display:block;width:100%;max-width:520rpx;margin:0 auto;border-radius:16rpx}.customer-service__tip{margin-top:20rpx;color:#475569;font-size:28rpx;line-height:42rpx}
