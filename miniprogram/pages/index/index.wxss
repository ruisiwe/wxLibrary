.home{min-height:100vh;padding:0 0 160rpx;box-sizing:border-box;background:#f6f8fb}
.home__hero{height:178rpx;padding:72rpx 32rpx 0;box-sizing:border-box;background:linear-gradient(120deg,#071d46,#0b3d78 52%,#102944);position:relative;overflow:hidden}
.home__hero::after{content:"";position:absolute;right:-36rpx;top:-42rpx;width:260rpx;height:260rpx;border-radius:50%;background:rgba(255,255,255,.08)}
.home__brand{position:relative;z-index:1;color:#fff;font-size:44rpx;font-weight:700;letter-spacing:2rpx;text-shadow:0 4rpx 12rpx rgba(0,0,0,.28)}
.home__section-title{display:flex;align-items:center;gap:12rpx;height:68rpx;padding:0 28rpx;background:#fff;color:#1f2937;font-size:28rpx;font-weight:700}
.home__section-bar{width:6rpx;height:30rpx;border-radius:999rpx;background:#ff8a3d}
.home promotion-strip{display:block;margin:0 0 28rpx;padding:0 28rpx;box-sizing:border-box;background:#fff}
.home category-grid{display:block;margin:0 28rpx 28rpx}
.documents{margin:0 28rpx;background:#fff;border-radius:24rpx;padding:0 24rpx}
