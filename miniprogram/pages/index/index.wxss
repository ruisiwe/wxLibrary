.home {
  min-height: 100vh;
  padding: 0 0 160rpx;
  box-sizing: border-box;
  background: #f6f8fb
}

.home__hero {
  height: 80rpx;
  padding: 12rpx 32rpx 0;
  box-sizing: border-box;
  background: #0B1F3A;
  position: relative;
  overflow: hidden
}

.home__brand {
  position: relative;
  z-index: 1;
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, .28)
}

.home__section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 68rpx;
  padding: 0 28rpx;
  background: #fff;
  color: #1f2937;
  font-size: 28rpx;
  font-weight: 700
}

.home__section-bar {
  width: 6rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: #ff8a3d
}

.home__search-row {
  padding: 16rpx 28rpx 6rpx;
  box-sizing: border-box;
  background: #fff
}

.home__search {
  display: flex;
  align-items: center;
  width: 100%;
  height: 68rpx;
  padding: 0 18rpx 0 24rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #f1f5f9
}

.home__search input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  color: #0f172a;
  font-size: 26rpx;
  font-weight: 400
}

.home__search-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 68rpx
}

.home promotion-strip {
  display: block;
  margin: 0 0 28rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: #fff
}

.home category-grid {
  display: block;
  margin: 0 0 12rpx
}

.documents {
  margin: 0;
  background: #fff;
  border-radius: 0;
  padding: 0 28rpx
}
