<view class="page">
  <view wx:if="{{!profile}}" class="login">
    <view wx:if="{{authChecking}}">正在登录...</view>
    <login-sheet wx:else visible="{{loginVisible}}" embedded="{{true}}" agreements="{{agreements}}" profile-required="{{profileRequired}}" bindclose="closeLogin" bindsubmit="submitLogin" />
  </view>
  <view wx:else>
    <view class="user">
      <image src="{{profile.avatarUrl}}" />
      <view class="user__details">
        <view class="nickname-row">
          <view class="nickname">{{profile.nickname}}</view>
          <view
            class="nickname-edit {{nicknameSaving ? 'nickname-edit--saving' : ''}}"
            bindtap="editNickname"
            aria-role="button"
            aria-label="修改昵称"
          >
            <t-icon name="edit-1" size="24rpx" color="rgba(255,255,255,.72)" />
            <text>修改昵称</text>
          </view>
        </view>
        <view>{{profile.pointBalance}} 积分 · {{profile.vipActive ? 'VIP 至 '+profile.vipExpireTime : '普通用户'}}</view>
      </view>
    </view>
    <view class="menu">
      <view data-url="/pages/my-documents/my-documents" bindtap="open">我的文档 <text>›</text></view>
      <view data-url="/pages/favorites/favorites" bindtap="open">我的收藏 <text>›</text></view>
      <view data-url="/pages/redeem-course/redeem-course" bindtap="open">会员兑换 <text>›</text></view>
      <view data-url="/pages/agreement/agreement?type=PRIVACY" bindtap="open">用户隐私协议 <text>›</text></view>
      <view class="menu-action">
        <text>意见反馈</text>
        <text>›</text>
        <button class="menu-button" open-type="feedback" aria-label="意见反馈"></button>
      </view>
      <view class="menu-action">
        <text>联系客服</text>
        <text>›</text>
        <button class="menu-button" open-type="contact" aria-label="联系客服"></button>
      </view>
    </view>
  </view>
</view>
