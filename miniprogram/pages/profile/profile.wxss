.page{min-height:100vh;padding:30rpx 30rpx 160rpx}.login{margin-top:160rpx;text-align:center;color:#64748b}.login button{margin-top:32rpx;width:360rpx;background:#2457d6;color:#fff}.user{display:flex;align-items:center;padding:36rpx;background:#0b1f3a;color:#fff;border-radius:28rpx}.user image{width:120rpx;height:120rpx;border-radius:60rpx;margin-right:24rpx;background:#e2e8f0}.user__details{flex:1;min-width:0}.nickname-row{display:flex;align-items:center;min-width:0;margin-bottom:14rpx}.nickname{min-width:0;margin-bottom:0;overflow:hidden;font-size:36rpx;font-weight:600;text-overflow:ellipsis;white-space:nowrap}.nickname-edit{display:flex;flex-shrink:0;align-items:center;margin-left:16rpx;color:rgba(255,255,255,.72);font-size:22rpx;font-weight:400;line-height:32rpx}.nickname-edit text{margin-left:6rpx}.nickname-edit--saving{opacity:.5}.menu{margin-top:28rpx;background:#fff;border-radius:24rpx;overflow:hidden}.menu>view{position:relative;display:flex;justify-content:space-between;align-items:center;width:100%;padding:30rpx;border-bottom:1rpx solid #eef2f7;background:#fff;color:#0f172a;font-size:32rpx;font-weight:400;text-align:left;line-height:1.4;box-sizing:border-box}.menu-button{position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%;margin:0;padding:0;border:0;border-radius:0;background:transparent;opacity:0;z-index:1}.menu-button::after{border:0}
