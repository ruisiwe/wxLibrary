<view class="page">
  <state-view loading="{{loading}}" error="{{error}}" bindretry="load" />
  <view wx:if="{{course}}">
    <image class="cover" src="{{course.coverUrl}}" mode="aspectFill" />
    <view class="info">
      <view class="title">{{course.title}}</view><text class="label">{{course.accessLabel}}</text>
      <view class="summary">{{course.summary}}</view>
    </view>
    <view class="videos">
      <view class="heading">课程目录</view>
      <view wx:for="{{videos}}" wx:key="id" class="video" data-id="{{item.id}}" bindtap="play"><text>{{index+1}}. {{item.title}}</text><text>{{item.durationSeconds || 0}} 秒 ›</text></view>
    </view>
  </view>
</view>