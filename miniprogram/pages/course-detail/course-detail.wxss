.page{min-height:100vh;padding:30rpx}.cover{width:100%;height:360rpx;border-radius:24rpx;background:#e2e8f0}.info,.videos{margin-top:24rpx;padding:28rpx;background:#fff;border-radius:24rpx}.title,.heading{font-size:36rpx;font-weight:600}.label{display:inline-block;margin-top:16rpx;padding:8rpx 16rpx;color:#1e40af;background:#dbeafe;border-radius:20rpx;font-size:22rpx}.summary{margin-top:20rpx;color:#64748b;line-height:1.7}.video{display:flex;justify-content:space-between;padding:28rpx 0;border-top:1rpx solid #eef2f7;color:#334155}.video text:last-child{color:#64748b;font-size:24rpx}
