<view class="page"><view wx:for="{{items}}" wx:key="id" class="course" data-id="{{item.id}}" bindtap="open"><image src="{{item.coverUrl}}" mode="aspectFill"/><view><view>{{item.title}}</view><text>{{item.sourceLabel}}</text></view></view><state-view loading="{{loading}}" error="{{error}}" empty="{{!loading && !error && !items.length}}" empty-text="暂无可观看课程" bindretry="load"/></view>
