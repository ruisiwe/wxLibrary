<view class="page"><view class="balance"><text>当前积分</text><text class="balance__number">{{balance}}</text></view><view class="tasks"><button bindtap="signIn">每日签到</button><button bindtap="watchAd">激励视频（{{adCount}}/5）</button><button open-type="share" bindtap="invite">分享与邀请</button></view><view class="rules"><view class="heading">积分任务</view><view wx:for="{{rules}}" wx:key="id" class="rule"><text>{{item.ruleName || item.ruleCode}}</text><text>+{{item.rewardPoints}}</text></view></view><view class="ledger"><view class="heading">积分流水</view><view wx:for="{{records}}" wx:key="id" class="record"><view><text>{{item.sourceType}}</text><text class="time">{{item.createTime}}</text></view><text class="change">{{item.changeAmount > 0 ? '+' : ''}}{{item.changeAmount}}</text></view></view><state-view loading="{{loading}}" error="{{error}}" bindretry="load"/></view>
