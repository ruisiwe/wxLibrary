<view class="page">
  <view class="balance"><text>当前积分</text><text class="balance__number">{{balance}}</text></view>
  <view class="ledger">
    <view class="heading">积分流水</view>
    <view wx:for="{{records}}" wx:key="id" class="record">
      <view><text>{{item.sourceType}}</text><text class="time">{{item.createDate}}</text></view>
      <text class="change">{{item.changeAmount > 0 ? '+' : ''}}{{item.changeAmount}}</text>
    </view>
  </view>
  <state-view loading="{{loading}}" error="{{error}}" empty="{{!loading && !error && !records.length}}" empty-text="暂无积分流水" bindretry="load"/>
</view>
