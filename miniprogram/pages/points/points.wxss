.page{min-height:100vh;padding:30rpx}.balance{padding:44rpx;background:linear-gradient(135deg,#0b1f3a,#2457d6);border-radius:28rpx;color:#fff}.balance__number{display:block;margin-top:12rpx;font-size:64rpx;font-weight:700}.ledger{margin-top:24rpx;padding:28rpx;background:#fff;border-radius:24rpx}.heading{font-size:32rpx;font-weight:600;margin-bottom:16rpx}.record{display:flex;justify-content:space-between;padding:20rpx 0;border-top:1rpx solid #eef2f7}.record>view{display:flex;flex-direction:column}.time{margin-top:8rpx;color:#94a3b8;font-size:22rpx}.change{color:#f59e0b;font-weight:600}
