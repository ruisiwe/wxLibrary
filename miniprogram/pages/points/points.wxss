.page{min-height:100vh;padding:30rpx}.balance{padding:44rpx;background:linear-gradient(135deg,#0b1f3a,#2457d6);border-radius:28rpx;color:#fff}.balance__number{display:block;margin-top:12rpx;font-size:64rpx;font-weight:700}.tasks{display:grid;grid-template-columns:repeat(3,1fr);gap:16rpx;margin:28rpx 0}.tasks button{font-size:23rpx;line-height:1.4;padding:22rpx 8rpx;background:#fff}.rules,.ledger{margin-top:24rpx;padding:28rpx;background:#fff;border-radius:24rpx}.heading{font-size:32rpx;font-weight:600;margin-bottom:16rpx}.rule,.record{display:flex;justify-content:space-between;padding:20rpx 0;border-top:1rpx solid #eef2f7}.record>view{display:flex;flex-direction:column}.time{margin-top:8rpx;color:#94a3b8;font-size:22rpx}.change{color:#f59e0b;font-weight:600}
