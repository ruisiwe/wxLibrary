.page{min-height:100vh;padding:30rpx}.login{margin-top:180rpx;padding:48rpx;text-align:center;background:#fff;border-radius:24rpx}.login button{margin-top:28rpx;background:#2457d6;color:#fff}.member-card{padding:42rpx;background:linear-gradient(135deg,#0b1f3a,#334155);color:#fef3c7;border-radius:28rpx}.member-card__label{font-size:24rpx;opacity:.8}.member-card__status{margin-top:12rpx;font-size:42rpx;font-weight:700}.member-card__expiry{margin-top:14rpx}.member-card button{margin:24rpx 0 0;background:#fef3c7;color:#0b1f3a}.points-card{display:flex;align-items:center;justify-content:space-between;margin-top:24rpx;padding:30rpx;background:#fff;border-radius:24rpx}.points-card__number{display:block;margin-top:8rpx;font-size:52rpx;font-weight:700;color:#2457d6}.points-card__link{color:#64748b}.tasks{margin-top:24rpx;padding:30rpx;background:#fff;border-radius:28rpx}.heading{font-size:32rpx;font-weight:700;margin-bottom:18rpx;color:#0f172a}.rule-list{display:block;width:100%}.rule{position:relative;display:flex;align-items:center;width:100%;min-height:96rpx;margin:0;padding:18rpx 0;border-top:1rpx solid #eef2f7;background:#fff;color:#0f172a;box-sizing:border-box}.rule:first-child{border-top:0}.rule__main{display:flex;flex:1;min-width:0;flex-direction:column;text-align:left}.rule__title{font-size:29rpx;font-weight:600;line-height:38rpx;color:#111827;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.rule__progress{margin-top:6rpx;font-size:24rpx;line-height:32rpx;color:#94a3b8}.rule__action{flex:none;min-width:96rpx;margin-left:auto;padding:7rpx 18rpx;border-radius:999rpx;background:#fff7ed;color:#f59e0b;font-size:25rpx;font-weight:700;line-height:32rpx;text-align:center;box-sizing:border-box}.rule__action--done{background:#ecfdf5;color:#10b981}.rule__trigger{position:absolute;top:0;right:0;bottom:0;left:0;display:block;width:auto;height:auto;margin:0;padding:0;border-radius:0;background:transparent;opacity:0;z-index:1}.rule__trigger::after{border:0}
