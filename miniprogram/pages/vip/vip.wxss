.page{min-height:100vh;padding:30rpx}.login{margin-top:180rpx;padding:48rpx;text-align:center;background:#fff;border-radius:24rpx}.login button{margin-top:28rpx;background:#2457d6;color:#fff}.member-card{padding:42rpx;background:linear-gradient(135deg,#0b1f3a,#334155);color:#fef3c7;border-radius:28rpx}.member-card__label{font-size:24rpx;opacity:.8}.member-card__status{margin-top:12rpx;font-size:42rpx;font-weight:700}.member-card__expiry{margin-top:14rpx}.member-card button{margin:24rpx 0 0;background:#fef3c7;color:#0b1f3a}.points-card{display:flex;align-items:center;justify-content:space-between;margin-top:24rpx;padding:30rpx;background:#fff;border-radius:24rpx}.points-card__number{display:block;margin-top:8rpx;font-size:52rpx;font-weight:700;color:#2457d6}.points-card__link{color:#64748b}.tasks{margin-top:24rpx;padding:28rpx;background:#fff;border-radius:24rpx}.heading{font-size:32rpx;font-weight:600;margin-bottom:18rpx}.rule{display:flex;align-items:center;justify-content:space-between;width:100%;margin:0;padding:22rpx 0;border-top:1rpx solid #eef2f7;background:#fff;color:#0f172a;text-align:left;font-size:28rpx}.rule::after{border:0}.rule text:last-child{color:#f59e0b;font-weight:600}
