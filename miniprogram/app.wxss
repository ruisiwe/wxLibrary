page {
  --color-navy: #0b1f3a;
  --color-cobalt: #2457d6;
  --color-orange: #f59e0b;
  min-height: 100%;
  background: #f5f7fa;
  color: var(--color-navy);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page-shell {
  min-height: 100vh;
  padding: 48rpx 32rpx 160rpx;
  box-sizing: border-box;
}

.page-shell__title {
  margin: 0;
  font-size: 48rpx;
  font-weight: 600;
}
