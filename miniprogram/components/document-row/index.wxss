.row{display:flex;padding:28rpx 0;border-bottom:1rpx solid #e5e7eb}.row__cover{width:144rpx;height:144rpx;border-radius:12rpx;background:#fff;flex:none}.row__body{display:flex;flex-direction:column;gap:14rpx;margin-left:24rpx;min-width:0}.row__title-line{display:flex;align-items:center;gap:10rpx;min-width:0}.row__file-type{flex:none;padding:2rpx 8rpx;background:#e53935;color:#fff;border-radius:6rpx;font-size:20rpx;font-weight:700;line-height:30rpx}.row__title{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:30rpx;font-weight:600}.row__summary{color:#64748b;font-size:25rpx;line-height:1.5;overflow:hidden}.row__tag,.row__points{font-size:23rpx;color:#64748b;margin-right:24rpx}.row__points{color:#f59e0b}
