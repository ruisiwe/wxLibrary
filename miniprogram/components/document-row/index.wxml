<view class="row" bindtap="open">
  <image class="row__cover" src="{{document.coverUrl}}" mode="aspectFit" />
  <view class="row__body">
    <view class="row__title-line">
      <text wx:if="{{showFileType && fileType}}" class="row__file-type">{{fileType}}</text>
      <text class="row__title">{{document.title}}</text>
    </view>
    <text class="row__summary">{{document.summary || '暂无简介'}}</text>
    <view><text class="row__tag">{{document.pageCount || 0}} 页</text><text class="row__points">{{document.pointPrice || 0}} 积分</text></view>
  </view>
</view>
