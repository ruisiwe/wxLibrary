<view wx:if="{{visible}}" class="{{embedded ? 'login-host' : 'mask'}}" bindtap="handleRootTap">
  <view class="sheet {{embedded ? 'sheet--embedded' : ''}}" catchtap="noop">
    <view class="sheet__title">{{profileRequired ? '质控文库' : '阅读隐私协议'}}</view>
    <block wx:if="{{profileRequired}}">
      <button class="submit" open-type="chooseAvatar" bindchooseavatar="chooseAvatarAndSubmit">登录</button>
    </block>
    <block wx:else>
      <scroll-view scroll-y class="privacy-content">
        <rich-text wx:if="{{privacyContent}}" nodes="{{privacyContent}}"/>
        <text wx:else>当前隐私协议暂不可用，请稍后再试。</text>
      </scroll-view>
      <view class="agreement-actions">
        <button class="reject" bindtap="rejectAgreement">拒绝</button>
        <button class="submit agreement-submit" bindtap="submit">同意</button>
      </view>
    </block>
  </view>
</view>
