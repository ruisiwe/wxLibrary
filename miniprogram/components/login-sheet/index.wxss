.mask{position:fixed;inset:0;background:rgba(11,31,58,.55);z-index:30;display:flex;align-items:flex-end}.sheet{width:100%;padding:40rpx 36rpx 64rpx;background:#fff;border-radius:32rpx 32rpx 0 0}.sheet__title{font-size:36rpx;font-weight:600;margin-bottom:28rpx}.avatar{width:180rpx;height:180rpx;border-radius:90rpx;padding:0;display:flex;align-items:center;justify-content:center;font-size:26rpx}.avatar image{width:100%;height:100%;border-radius:50%}.input{margin:28rpx 0;padding:24rpx;background:#f1f5f9;border-radius:16rpx}.agreement{display:block;margin:22rpx 0;font-size:25rpx}.submit{margin-top:30rpx;background:#2457d6;color:#fff}
