.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-template-rows: repeat(2, 160rpx);
  background: #fff;
  overflow: hidden
}

.grid__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-right: 1rpx solid #edf1f7;
  border-bottom: 1rpx solid #edf1f7;
  font-size: 24rpx;
  color: #27364a
}

.grid__item:nth-child(4n) {
  border-right: 0
}

.grid__item:nth-last-child(-n+4) {
  border-bottom: 0
}

.grid__icon-shell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 14rpx;
  border-radius: 22rpx;
  background: transparent;
  box-shadow: none
}

.grid__icon {
  display: block;
  width: 50rpx;
  height: 50rpx;
  color: #0b56c5
}

.grid__label {
  line-height: 34rpx
}